// Sales Management System (CRM) – PostgreSQL schema
// Money: Decimal(14,2). Percentages: Decimal(5,2). All tables carry createdAt/updatedAt.
// Cached totals on Quotation/Invoice are written only inside the same transaction that writes the
// line items (see docs/ARCHITECTURE.md, rule B6). Additional CHECK constraints live in the migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  EVENT
  COLD_CALL
  PARTNER
  OTHER
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
  CANCELLED
  SUPERSEDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  REVISED
}

enum ApproverType {
  TEAM_MANAGER
  ROLE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  OTHER
}

enum TargetPeriodType {
  MONTH
  QUARTER
  YEAR
}

enum NotificationType {
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  INVOICE_OVERDUE
  LEAD_ASSIGNED
  TARGET_SET
  SYSTEM
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  teamId             String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  team         Team?      @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedTeams Team[]     @relation("TeamManager")
  roles        UserRole[] @relation("UserRoles")
  rolesGranted UserRole[] @relation("RoleGrantor")
  sessions     Session[]

  customers             Customer[]        @relation("CustomerOwner")
  leads                 Lead[]            @relation("LeadOwner")
  opportunities         Opportunity[]     @relation("OpportunityOwner")
  activities            Activity[]        @relation("ActivityOwner")
  quotations            Quotation[]       @relation("QuotationOwner")
  approvalRequests      ApprovalRequest[] @relation("ApprovalRequester")
  approvalAssignments   ApprovalRequest[] @relation("ApprovalAssignee")
  approvalDecisions     ApprovalRequest[] @relation("ApprovalDecider")
  approvalHistory       ApprovalHistory[]
  targets               SalesTarget[]     @relation("TargetUser")
  targetsSet            SalesTarget[]     @relation("TargetSetter")
  invoicesAsSalesperson Invoice[]         @relation("InvoiceSalesperson")
  invoicesCreated       Invoice[]         @relation("InvoiceCreator")
  paymentsRecorded      Payment[]         @relation("PaymentRecorder")
  paymentsVoided        Payment[]         @relation("PaymentVoider")
  creditUpdates         CustomerCredit[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  settingsUpdated       SystemSetting[]

  @@index([teamId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         UserRole[]
  permissions   RolePermission[]
  approvalRules ApprovalRule[]
  approvalReqs  ApprovalRequest[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String
  group       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  grantedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  managerId String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager User?         @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members User[]        @relation("TeamMembers")
  targets SalesTarget[]

  @@index([managerId])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────────────── Sales ─────────────────────────────

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  industry  String?
  address   String?
  taxId     String?
  ownerId   String   @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User            @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  quotations    Quotation[]
  invoices      Invoice[]
  credit        CustomerCredit?

  @@index([ownerId])
  @@index([name])
}

model Lead {
  id                  String     @id @default(uuid()) @db.Uuid
  title               String
  contactName         String
  company             String?
  email               String?
  phone               String?
  source              LeadSource @default(OTHER)
  status              LeadStatus @default(NEW)
  estimatedValue      Decimal?   @db.Decimal(14, 2)
  notes               String?
  ownerId             String     @db.Uuid
  convertedCustomerId String?    @db.Uuid
  convertedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  owner             User          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  convertedCustomer Customer?     @relation(fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  opportunities     Opportunity[]
  activities        Activity[]

  @@index([ownerId])
  @@index([status])
}

model Opportunity {
  id                String           @id @default(uuid()) @db.Uuid
  name              String
  customerId        String           @db.Uuid
  leadId            String?          @db.Uuid
  ownerId           String           @db.Uuid
  stage             OpportunityStage @default(PROSPECTING)
  amount            Decimal          @db.Decimal(14, 2)
  probability       Int              @default(10)
  expectedCloseDate DateTime?        @db.Date
  closedAt          DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner      User        @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  quotations Quotation[]
  activities Activity[]

  @@index([ownerId])
  @@index([customerId])
  @@index([stage])
  @@index([closedAt])
}

model Activity {
  id            String       @id @default(uuid()) @db.Uuid
  type          ActivityType
  subject       String
  description   String?
  dueAt         DateTime?
  completedAt   DateTime?
  ownerId       String       @db.Uuid
  customerId    String?      @db.Uuid
  leadId        String?      @db.Uuid
  opportunityId String?      @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  owner       User         @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([dueAt])
}

model Quotation {
  id            String          @id @default(uuid()) @db.Uuid
  number        String
  version       Int             @default(1)
  parentId      String?         @unique @db.Uuid
  customerId    String          @db.Uuid
  opportunityId String?         @db.Uuid
  ownerId       String          @db.Uuid
  status        QuotationStatus @default(DRAFT)
  issueDate     DateTime        @default(now()) @db.Date
  validUntil    DateTime        @db.Date
  currency      String          @default("USD") @db.VarChar(3)
  notes         String?
  terms         String?
  // Cached totals – recalculated in the same transaction as item writes.
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  submittedAt   DateTime?
  approvedAt    DateTime?
  sentAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  opportunity      Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner            User              @relation("QuotationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  parent           Quotation?        @relation("QuotationRevision", fields: [parentId], references: [id], onDelete: Restrict)
  revision         Quotation?        @relation("QuotationRevision")
  items            QuotationItem[]
  approvalRequests ApprovalRequest[]
  invoices         Invoice[]

  @@unique([number, version])
  @@index([ownerId])
  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id              String  @id @default(uuid()) @db.Uuid
  quotationId     String  @db.Uuid
  position        Int
  description     String
  quantity        Decimal @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, position])
}

// ───────────────────────────── Approvals ─────────────────────────────

model ApprovalRule {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  minAmount      Decimal      @db.Decimal(14, 2)
  maxAmount      Decimal?     @db.Decimal(14, 2) // exclusive upper bound; null = unbounded
  approverType   ApproverType
  approverRoleId String       @db.Uuid
  priority       Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  approverRole Role              @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)
  requests     ApprovalRequest[]
}

model ApprovalRequest {
  id               String         @id @default(uuid()) @db.Uuid
  quotationId      String         @db.Uuid
  quotationVersion Int
  amount           Decimal        @db.Decimal(14, 2) // snapshot of total at submission
  requestedById    String         @db.Uuid
  ruleId           String?        @db.Uuid
  approverRoleId   String         @db.Uuid
  assignedToId     String?        @db.Uuid // null = any active holder of approverRole
  status           ApprovalStatus @default(PENDING)
  decidedById      String?        @db.Uuid
  decidedAt        DateTime?
  decisionComment  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  quotation    Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestedBy  User              @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  rule         ApprovalRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  approverRole Role              @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)
  assignedTo   User?             @relation("ApprovalAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  decidedBy    User?             @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  history      ApprovalHistory[]

  @@index([quotationId])
  @@index([status])
  @@index([assignedToId])
  @@index([approverRoleId])
}

model ApprovalHistory {
  id                String         @id @default(uuid()) @db.Uuid
  approvalRequestId String         @db.Uuid
  action            ApprovalAction
  actorId           String         @db.Uuid
  comment           String?
  createdAt         DateTime       @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  actor           User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([approvalRequestId])
}

// ───────────────────────────── Targets ─────────────────────────────

model SalesTarget {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String?          @db.Uuid
  teamId      String?          @db.Uuid
  periodType  TargetPeriodType
  periodStart DateTime         @db.Date
  periodEnd   DateTime         @db.Date
  amount      Decimal          @db.Decimal(14, 2)
  notes       String?
  setById     String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user  User? @relation("TargetUser", fields: [userId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  setBy User  @relation("TargetSetter", fields: [setById], references: [id], onDelete: Restrict)

  @@unique([userId, periodStart, periodEnd])
  @@unique([teamId, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
}

// ───────────────────────────── Finance ─────────────────────────────

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  number        String        @unique
  customerId    String        @db.Uuid
  quotationId   String?       @db.Uuid
  salespersonId String?       @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime?     @db.Date
  dueDate       DateTime?     @db.Date
  currency      String        @default("USD") @db.VarChar(3)
  notes         String?
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2) // maintained in the payment transaction
  cancelledAt   DateTime?
  cancelReason  String?
  createdById   String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation   Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  salesperson User?         @relation("InvoiceSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  payments    Payment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([salespersonId])
}

model InvoiceItem {
  id              String  @id @default(uuid()) @db.Uuid
  invoiceId       String  @db.Uuid
  position        Int
  description     String
  quantity        Decimal @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @db.Uuid
  amount       Decimal       @db.Decimal(14, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @db.Date
  notes        String?
  recordedById String        @db.Uuid
  voidedAt     DateTime?
  voidedById   String?       @db.Uuid
  voidReason   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?   @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paidAt])
}

model CustomerCredit {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @unique @db.Uuid
  creditLimit      Decimal  @db.Decimal(14, 2)
  paymentTermsDays Int      @default(30)
  onHold           Boolean  @default(false)
  notes            String?
  updatedById      String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

// ───────────────────────────── Platform ─────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}
