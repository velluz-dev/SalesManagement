enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  KPAY
  OTHER
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  number        String        @unique
  customerId    String        @db.Uuid
  quotationId   String?       @db.Uuid
  salesOrderId  String?       @db.Uuid
  paymentTermId String?       @db.Uuid
  salespersonId String?       @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime?     @db.Date
  dueDate       DateTime?     @db.Date
  currency      String        @default("MMK") @db.VarChar(3)
  notes         String?
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  cancelledAt   DateTime?
  cancelReason  String?
  createdById   String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation   Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  salesOrder  SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  paymentTerm PaymentTerm?  @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  salesperson User?         @relation("InvoiceSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  payments    Payment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([salespersonId])
  @@index([salesOrderId])
}

model InvoiceItem {
  id              String  @id @default(uuid()) @db.Uuid
  invoiceId       String  @db.Uuid
  productId       String? @db.Uuid
  position        Int
  description     String
  quantity        Decimal @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, position])
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @db.Uuid
  amount       Decimal       @db.Decimal(14, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @db.Date
  notes        String?
  recordedById String        @db.Uuid
  voidedAt     DateTime?
  voidedById   String?       @db.Uuid
  voidReason   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?   @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paidAt])
}

model CustomerCredit {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @unique @db.Uuid
  creditLimit Decimal  @db.Decimal(14, 2)
  onHold      Boolean  @default(false)
  notes       String?
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}
