// Contracts (from accepted quotations) and sales orders (fulfilment, then invoicing).

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

model Contract {
  id           String         @id @default(uuid()) @db.Uuid
  number       String         @unique
  quotationId  String         @unique @db.Uuid
  customerId   String         @db.Uuid
  ownerId      String         @db.Uuid
  title        String
  startDate    DateTime       @db.Date
  endDate      DateTime?      @db.Date
  value        Decimal        @db.Decimal(14, 2) // snapshot of the quotation total
  currency     String         @default("USD") @db.VarChar(3)
  status       ContractStatus @default(ACTIVE)
  terms        String?
  documentUrl  String?
  cancelReason String?
  createdById  String         @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  quotation Quotation    @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer  Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  owner     User         @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy User         @relation("ContractCreator", fields: [createdById], references: [id], onDelete: Restrict)
  orders    SalesOrder[]

  @@index([ownerId])
  @@index([customerId])
  @@index([status])
}

model SalesOrder {
  id            String           @id @default(uuid()) @db.Uuid
  number        String           @unique
  customerId    String           @db.Uuid
  ownerId       String           @db.Uuid
  contractId    String?          @db.Uuid
  quotationId   String?          @db.Uuid
  status        SalesOrderStatus @default(PENDING)
  orderDate     DateTime         @db.Date
  deliveryDate  DateTime?        @db.Date
  currency      String           @default("USD") @db.VarChar(3)
  notes         String?
  // Cached totals, written only in the same transaction as the items (rule B6).
  subtotal      Decimal          @default(0) @db.Decimal(14, 2)
  discountTotal Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal          @default(0) @db.Decimal(14, 2)
  total         Decimal          @default(0) @db.Decimal(14, 2)
  confirmedAt   DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdById   String           @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  owner     User             @relation("SalesOrderOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy User             @relation("SalesOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  contract  Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  quotation Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items     SalesOrderItem[]
  invoices  Invoice[]

  @@index([ownerId])
  @@index([customerId])
  @@index([contractId])
  @@index([status])
}

model SalesOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  salesOrderId    String  @db.Uuid
  productId       String? @db.Uuid
  position        Int
  description     String
  quantity        Decimal @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([salesOrderId, position])
}
