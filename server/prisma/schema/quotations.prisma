enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
  CANCELLED
  SUPERSEDED
  EXPIRED
}

model Quotation {
  id            String          @id @default(uuid()) @db.Uuid
  number        String
  version       Int             @default(1)
  parentId      String?         @unique @db.Uuid
  customerId    String          @db.Uuid
  opportunityId String?         @db.Uuid
  ownerId       String          @db.Uuid
  status        QuotationStatus @default(DRAFT)
  issueDate     DateTime        @default(now()) @db.Date
  validUntil    DateTime        @db.Date
  currency      String          @default("MMK") @db.VarChar(3)
  notes         String?
  terms         String?
  paymentTermId String?         @db.Uuid
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  submittedAt   DateTime?
  approvedAt    DateTime?
  sentAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  opportunity      Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner            User              @relation("QuotationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  paymentTerm      PaymentTerm?      @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  parent           Quotation?        @relation("QuotationRevision", fields: [parentId], references: [id], onDelete: Restrict)
  revision         Quotation?        @relation("QuotationRevision")
  items            QuotationItem[]
  approvalRequests ApprovalRequest[]
  invoices         Invoice[]
  contract         Contract?
  salesOrders      SalesOrder[]

  @@unique([number, version])
  @@index([ownerId])
  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id              String  @id @default(uuid()) @db.Uuid
  quotationId     String  @db.Uuid
  productId       String? @db.Uuid
  position        Int
  description     String
  quantity        Decimal @db.Decimal(12, 2)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([quotationId, position])
}
