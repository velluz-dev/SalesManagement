# --- Server environment (copy to .env) ---
NODE_ENV=development
PORT=4000
# PostgreSQL connection string. Never expose this to the frontend.
DATABASE_URL=postgresql://postgres@localhost:5432/sales_crm?schema=public
# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
CORS_ORIGINS=http://localhost:5180
# Session lifetime
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Set to true behind HTTPS (always true in production)
COOKIE_SECURE=false
# Interval for the overdue-invoice scanner (minutes, 0 disables)
OVERDUE_SCAN_MINUTES=60
