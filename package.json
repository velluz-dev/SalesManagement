{
  "name": "sales-crm",
  "private": true,
  "version": "1.0.0",
  "description": "Role-based Sales Management System (CRM)",
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "db:deploy": "npm run db:deploy --workspace server"
  },
  "engines": {
    "node": ">=20.19"
  }
}
